# ==========================================================
# Prabhasha Nexus - Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# ==========================================================

# ---- Flask ----
FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ---- Database ----
# Local development default is SQLite when DATABASE_URL is unset.
# Production MySQL example:
# DATABASE_URL=mysql+pymysql://nexus_user:password@localhost:3306/prabhasha_nexus?charset=utf8mb4
DATABASE_URL=

# Docker Compose MySQL service (used by docker-compose.yml)
MYSQL_DATABASE=prabhasha_nexus
MYSQL_USER=nexus
MYSQL_PASSWORD=change-nexus-password
MYSQL_ROOT_PASSWORD=change-root-password

# ---- CORS / URLs ----
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,null
FRONTEND_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# ---- Initial administrator ----
# Used only by the seed command. Change immediately after first login.
ADMIN_NAME=Prabhasha Dilshani
ADMIN_EMAIL=admin@prabhashanexus.local
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_AI=20 per hour
RATE_LIMIT_CONTACT=5 per hour

# ---- Uploads / storage ----
UPLOAD_DIR=uploads
BACKUP_DIR=backups
MAX_CONTENT_LENGTH_MB=25
MEDIA_STORAGE_BACKEND=local
# S3-compatible (optional, recommended for production)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---- AI / LLM ----
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDINGS_ENABLED=true
AI_TOP_K=5
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_TOKENS=700
AI_TIMEOUT_SECONDS=30

# ---- Knowledge base / RAG ----
KNOWLEDGE_DIR=app/ai/documents
FAISS_INDEX_DIR=app/ai/index

# ---- GitHub ----
GITHUB_USERNAME=prabhasha-2001
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=600

# ---- n8n automation ----
N8N_ENABLED=false
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=10

# ---- Email / SMTP ----
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@prabhashanexus.local

# ---- Analytics & privacy ----
ANALYTICS_SALT=change-me-analytics-salt
ANALYTICS_ENABLED=true

# ---- Docker runtime ----
# Set SEED_ON_START=false after the first successful deployment.
SEED_ON_START=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
